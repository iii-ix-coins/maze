# Safe template derived from the supplied runtime configuration.
# Provider credentials and URLs that may contain credentials were removed.
# Restore those values from a secure secret store; do not commit a populated .env.
# Never expose secrets via VITE_* variables.
MINT_ADDRESS=DiSetnR7k57wmfvywJhUVjPwWfg54SdQKxQdJEBYW23B
# Server-side Solana RPC only. Use a dedicated provider URL for production workloads.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TOKEN_SYMBOL=COIN
COIN_LAUNCH_DATE=2026-08-05T16:51:00Z
PORT=5000

# ==========================================
# SOLANA WALLET CONNECTION (Reown AppKit)
# Public Project ID from https://dashboard.reown.com
# This is a public client identifier, not a secret.
VITE_REOWN_PROJECT_ID=
# Exact public website origin; must match the Reown project domain allowlist.
VITE_APP_URL=https://hollld.fun

# ==========================================
# IDENTITY / SIGN-IN WITH SOLANA
# Comma-separated exact browser origins allowed to request wallet sign-in.
IDENTITY_ALLOWED_ORIGINS=https://hollld.fun
IDENTITY_CHALLENGE_TTL_SECONDS=300
IDENTITY_SESSION_TTL_DAYS=30
# Optional absolute path. Defaults to shared/data/identity.sqlite3.
# IDENTITY_DB_PATH=
# Set true only when deployed behind a trusted reverse proxy (for accurate client IP limits).
TRUST_PROXY=false
# Set true for HTTPS staging when NODE_ENV is not production.
# Production automatically enables Secure cookies.
# AUTH_COOKIE_SECURE=true

# ==========================================
# PCLQCH / PRICE ENGINE
# ==========================================
JUPITER_API=
INTERVAL_MS=1000
PRICE_TIMEOUT_MS=3000
PRICE_RETRY_COUNT=1
PRICE_RETRY_DELAY_MS=150
JUPITER_API_KEYS=
BIRDEYE_API_KEYS=
SOLANATRACKER_API_KEYS=


# ==========================================
# JUPITER MARKET DATA
# ==========================================
JUPITER_MARKET_DATA_ENABLED=true
JUPITER_API_KEY=
JUPITER_MARKET_MINT=DiSetnR7k57wmfvywJhUVjPwWfg54SdQKxQdJEBYW23B
JUPITER_MARKET_DATA_INTERVAL_MS=20000
JUPITER_MARKET_DATA_TIMEOUT_MS=10000
JUPITER_MARKET_DATA_REQUEST_GAP_MS=1200
JUPITER_MARKET_DATA_MAX_RETRIES=1
JUPITER_MARKET_DATA_HISTORY_ENABLED=true
JUPITER_MARKET_DATA_HISTORY_RETENTION_DAYS=30


# ==========================================
# PROCESS SUPERVISOR
# ==========================================
SHUTDOWN_TIMEOUT_MS=15000
SERVICE_RESTART_DELAY_MS=3000

# Maze multiplayer WebSocket server (run with npm run start:maze-server)
# For separate Railway services, set the exact site origin on maze-server.
MAZE_PORT=8081
MAZE_ALLOWED_ORIGINS=
# Build-time on the site service: wss://<maze-server-public-domain>
# The Home Game Feed derives the read-only https://<maze-server-public-domain>/rooms endpoint from this value.
MAZE_PUBLIC_URL=
