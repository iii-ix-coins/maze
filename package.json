{
  "name": "hollld-crypto-platform",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "description": "Single-root Vite + React frontend with the existing Express services and Maze game engines",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "nodemon start.js",
    "dev:site": "vite --config vite.config.mts --host 0.0.0.0",
    "build:site": "vite build --config vite.config.mts",
    "preview:site": "vite preview --config vite.config.mts --host 0.0.0.0",
    "build:maze-server": "node scripts/build-maze-server.mjs",
    "start:maze-server": "node --env-file-if-exists=.env dist/maze-server/server.cjs",
    "build:all": "node scripts/build-maze-server.mjs && vite build --config vite.config.mts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.mts --pool=threads",
    "test:maze": "npm run build:maze-server && node scripts/run-maze-tests.mjs",
    "test:all": "npm run test && npm run test:maze",
    "check:layout": "node scripts/check-layout.mjs",
    "check": "npm run check:layout && npm run typecheck && npm run build:all && npm run test:all"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "axios": "^1.6.8",
    "better-sqlite3": "^11.8.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.9",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "22.23.4"
  }
}